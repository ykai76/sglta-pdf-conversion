    "## Use this\n",
    "\n",
    "import pdfplumber\n",
    "import pandas as pd\n",
    "import re\n",
    "\n",
    "# Define the function to extract data from text instead of tables\n",
    "def extract_data_from_text(pdf_path):\n",
    "    data = []\n",
    "    \n",
    "    with pdfplumber.open(pdf_path) as pdf:\n",
    "        vehicle_type = None\n",
    "        make = None\n",
    "        date = None\n",
    "        \n",
    "        for page_num, page in enumerate(pdf.pages, start=1):\n",
    "            text = page.extract_text()\n",
    "            if not text:\n",
    "                print(f\"Warning: No text found on page {page_num}\")\n",
    "                continue  # Skip pages without extractable text\n",
    "\n",
    "            lines = text.split('\\n')\n",
    "            for i, line in enumerate(lines):\n",
    "                if \"Vehicle Type :\" in line:\n",
    "                    vehicle_type = line.split(\":\")[-1].strip()\n",
    "                elif \"Make :\" in line:\n",
    "                    make = line.split(\":\")[-1].strip()\n",
    "                elif \"Date :\" in line:\n",
    "                    date = line.split(\":\")[-1].strip()\n",
    "                else:\n",
    "                    if re.search(r\"\\bYES\\b|\\bNO\\b\", line):\n",
    "                        match = re.match(r\"(.+?)\\s+(Sedan/Saloon|Hatchback|Sport|Coupe|Convertible|Station-wago|Multi-purpos|Lorry|Van|Private Bus|Excursion|Goods cum|Taxi)\\s+(\\d+)\\s+([\\d.]+)\\s+(Petrol|Diesel|Electric|Hybrid|Petrol-Electric|Diesel-Electric)\\s+(Automatic|Sequential|Manual|Continuous)\\s+(YES|NO)\\s+(YES|NO)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\d.\\-]+)\\s+([\\w.\\-]+)\", line)\n",
    "                        mlist = list(match.groups()) + [vehicle_type, make, date, page_num]\n",
    "                        for j in range(i + 1, len(lines)):\n",
    "                            if not re.search(r\"\\bYES\\b|\\bNO\\b\", lines[j]):\n",
    "                                mlist[0] = mlist[0] + \" \" +lines[j]\n",
    "                            else:\n",
    "                                break\n",
    "                        data.append(mlist)\n",
    "            \n",
    "            if not data:\n",
    "                print(f\"Warning: No structured data extracted from page {page_num}\")\n",
    "\n",
    "    return data\n",
    "\n",
    "# Process the extracted data into a structured format\n",
    "def process_data(data):\n",
    "    columns = [\n",
    "        \"Model\", \"Body Type\", \"Engine (cc)\", \"MPO (kW)\", \"Fuel Type\", \"Transmission\", \n",
    "        \"Turbo\", \"Hybrid\", \"Urban (l/100km)\", \"Extra Urban (l/100km)\", \"Combined (l/100km)\", \n",
    "        \"Urban CO2 (g/km)\", \"Extra Urban CO2 (g/km)\", \"Combined CO2 (g/km)\", \"VES Band\",\n",
    "        \"Vehicle Type\", \"Make\", \"Date\", \"Page\"\n",
    "    ]\n",
    "    \n",
    "    df = pd.DataFrame(data, columns=columns)\n",
    "    return df\n",
    "\n",
    "# Read the PDF and extract data\n",
    "pdf_path = \"sglta7Jun.pdf\"\n",
    "data = extract_data_from_text(pdf_path)\n",
    "\n",
    "# Process extracted data into a DataFrame\n",
    "df = process_data(data)\n",
    "\n",
    "# Transformation\n",
    "df['Transmission'] = df['Transmission'].str.replace(\"Sequential\", \"Sequential Manual (SMT)\")\n",
    "df['Transmission'] = df['Transmission'].str.replace(\"Continuous\", \"Continuous Variable (CVT)\")\n",
    "df['Body Type'] = df['Body Type'].str.replace(\"Station-wago\", \"Station-wagon\")\n",
    "df['Body Type'] = df['Body Type'].str.replace(\"Multi-purpos\", \"Multi-purpose Vehicle (MPV)\")\n",
    "df['Body Type'] = df['Body Type'].str.replace(\"Goods cum\", \"Goods cum Passenger\")\n",
    "df['Body Type'] = df['Body Type'].str.replace(\"Excursion\", \"Excursion Bus\")\n",
    "df['Body Type'] = df['Body Type'].str.replace(\"Sport\", \"Sport Utility Vehicle (SUV)\") \n",
    "df['Model'] = df['Model'].str.replace(\" Manual (SMT)\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" Utility\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" (SUV)\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" Bus\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" Passenger\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\"e Vehicle\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" (MPV)\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" Vehicle\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" Variable (CVT)\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" n \", \"\")\n",
    "df.loc[df['Model'].str.contains('softtop', case=False, na=False), 'Body Type'] = 'Convertible (softtop)'\n",
    "df.loc[df['Model'].str.contains('hardtop', case=False, na=False), 'Body Type'] = 'Convertible (hardtop)'\n",
    "df['Model'] = df['Model'].str.replace(\" (softtop)\", \"\")\n",
    "df['Model'] = df['Model'].str.replace(\" (hardtop)\", \"\")\n",
    "df.loc[df['Model'].str.contains(r'\\(Plug-In\\)', case=False, na=False), 'Fuel Type'] += ' (Plug-In)'\n",
    "df['Model'] = df['Model'].str.replace(\" (Plug-In)\", \"\")\n",
    "df['Model'] = df['Model'].str.rstrip(' n')\n",
    "df['Model'] = df['Model'].str.replace(\"**End of Report**\",\"\")\n",
    "\n",
    "# Save to Excel file\n",
    "file_path = \"sglta_7jun.xlsx\"\n",
    "df.to_excel(file_path, index=False)\n",
    "\n",
    "print(f\"Excel file saved as {file_path}\")\n"
   ]
  }
